diff --git a/.github/actions/setup/action.yml b/.github/actions/setup/action.yml
index 4e1b317..a1736e8 100644
--- a/.github/actions/setup/action.yml
+++ b/.github/actions/setup/action.yml
@@ -16,7 +16,8 @@ runs:
         export DEBIAN_FRONTEND=noninteractive
         apt-get update -qq
         apt-get install -y -qq --no-install-recommends r-base-core=4.5.0-3 r-base-dev \
-          build-essential python3 curl ca-certificates git gh valgrind xz-utils > /dev/null
+          build-essential python3 curl ca-certificates git gh valgrind xz-utils \
+          libcurl4-openssl-dev > /dev/null
         R --version | head -1
         echo "R_HOME=$(R RHOME)" >> "$GITHUB_ENV"
     - if: inputs.rust == 'true'
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index a809413..e1d165e 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -36,6 +36,17 @@ jobs:
         run: cargo fmt --check
       - name: Build
         run: cargo build --release --workspace
+      # GNU R's base-package natives built from the R 4.5.0 sources
+      # (docs/core.md §8): robigo's dyn.load serves the base packages with
+      # them instead of the Rust ports (ROBIGO_NATIVES)
+      - uses: actions/cache@v4
+        with:
+          path: ~/.cache/robigo-research/rsrc
+          key: r-4.5.0-sources
+      - name: Base-package natives
+        run: |
+          scripts/build-natives.sh stats
+          echo "ROBIGO_NATIVES=$PWD/.robigo/natives" >> "$GITHUB_ENV"
       - name: Unit tests, parser oracle, conformance (all tiers)
         run: cargo test --release --workspace
       - name: Core and C API under gctorture (collect on every allocation)
@@ -45,12 +56,15 @@ jobs:
           python3 scripts/parse-corpus.py check fastr gnur-tests gnur-examples | tee -a "$GITHUB_STEP_SUMMARY"
       - name: Keep the binary for later jobs
         run: |
-          mkdir -p dist
+          mkdir -p dist/natives
           cp "$(cargo metadata --format-version 1 --no-deps | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')/release/robigo" dist/
+          for d in .robigo/natives/*/; do
+            p=$(basename "$d"); [ -f "$d$p.so" ] && mkdir -p "dist/natives/$p" && cp "$d$p.so" "dist/natives/$p/"
+          done
       - uses: actions/upload-artifact@v4
         with:
           name: robigo
-          path: dist/robigo
+          path: dist
           retention-days: 7
 
   corpora:
@@ -84,6 +98,7 @@ jobs:
       - run: chmod +x dist/robigo
       - name: Run ${{ matrix.corpus }} (${{ matrix.shard }})
         run: |
+          export ROBIGO_NATIVES="$PWD/dist/natives"
           python3 scripts/corpus.py run ${{ matrix.corpus }} --shard ${{ matrix.shard }} \
             --robigo dist/robigo --jobs "$(nproc)" | tee -a "$GITHUB_STEP_SUMMARY"
       - name: Name the results
@@ -114,6 +129,7 @@ jobs:
       - run: python3 scripts/perf.py fetch
       - name: Measure robigo (and GNU R on main)
         run: |
+          export ROBIGO_NATIVES="$PWD/dist/natives"
           export VALGRIND=valgrind
           runtime=robigo
           [ "${{ github.ref }}" = refs/heads/main ] && runtime=both
