Classes 'terms', 'formula'  language y ~ x + g
  ..- attr(*, "variables")= language list(y, x, g)
  ..- attr(*, "factors")= int [1:3, 1:2] 0 1 0 0 0 1
  .. ..- attr(*, "dimnames")=List of 2
  .. .. ..$ : chr [1:3] "y" "x" "g"
  .. .. ..$ : chr [1:2] "x" "g"
  ..- attr(*, "term.labels")= chr [1:2] "x" "g"
  ..- attr(*, "order")= int [1:2] 1 1
  ..- attr(*, "intercept")= int 1
  ..- attr(*, "response")= int 1
  ..- attr(*, ".Environment")=<environment: R_GlobalEnv> 
  ..- attr(*, "predvars")= language list(y, x, g)
  ..- attr(*, "dataClasses")= Named chr [1:3] "numeric" "numeric" "factor"
  .. ..- attr(*, "names")= chr [1:3] "y" "x" "g"
